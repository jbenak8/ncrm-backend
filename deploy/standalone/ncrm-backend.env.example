# Environment configuration for the standalone nCRM backend service ("db-auth" profile).
# Copy this file to "ncrm-backend.env", fill in the values and keep it readable only by the
# service account (chmod 600 on Linux; restrictive NTFS ACLs on Windows) - it contains secrets.

# Spring profile: database authentication, no Keycloak needed.
SPRING_PROFILES_ACTIVE=db-auth

# External PostgreSQL database.
DB_URL=jdbc:postgresql://localhost:5432/ncrm
DB_USERNAME=ncrm
DB_PASSWORD=change-me
DB_SCHEMA=ncrmbo
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
NCRM_CORS_ALLOWED_ORIGINS=

# External SMTP server used for outgoing e-mails.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Origins of the frontend allowed by CORS (comma-separated).
NCRM_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Shared HMAC secret used to sign the issued JWT access tokens (HS256).
# Must be a random string of at least 32 bytes, e.g. generated with "openssl rand -base64 48".
NCRM_JWT_SECRET=

# Validity of the issued access tokens (ISO-8601 duration).
NCRM_JWT_TTL=PT1H

# Optional AI provider API keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
